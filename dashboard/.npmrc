# next@14.2.35 + @cloudflare/next-on-pages@1.13.16 + wrangler@4.125.0 is the trio PayCraft
# runs in production, but it is no longer installable cleanly: next-on-pages now declares
# `next >=14.3.0` and `@cloudflare/workers-types@^4`, while current wrangler wants `^5`.
# PayCraft's tree predates both tightenings.
#
# This lives in .npmrc rather than a remembered `--legacy-peer-deps` flag because
# next-on-pages shells out to `vercel build`, which runs its OWN `npm install` — a flag
# passed on the outer command never reaches it, and the build fails with
# "Command npm install exited with 1".
legacy-peer-deps=true
